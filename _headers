# Cabeceras de Cloudflare Pages (este fichero no se sirve: Cloudflare lo lee al desplegar)

# Seguridad básica en todas las páginas
/*
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Imágenes: 30 días en caché (los nombres no llevan hash, así que no «immutable»)
/img/*
  Cache-Control: public, max-age=2592000

# Fuentes: un año, no cambian
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
